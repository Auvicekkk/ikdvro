<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <StackPanel MaxWidth="500" VerticalAlignment="Center">
            <StackPanel MaxWidth="300" VerticalAlignment="Center">
                <TextBlock Text="Jméno:" Margin="0,5,0,2" />
                <TextBox x:Name="txtInput1" Padding="5" />

                <TextBlock Text="Věk:" Margin="0,5,0,2" />
                <TextBox x:Name="txtInput2" Padding="5" />

                <TextBlock Text="Cena:" Margin="0,5,0,2" />
                <TextBox x:Name="txtInput3" Padding="5" />

                <TextBlock Text="Název Filmu:" Margin="0,5,0,2" />
                <TextBox x:Name="txtInput4" Padding="5" />

            </StackPanel>
            <Button x:Name="btnSubmit" 
                    Content="Odeslat" 
                    Margin="0,10,0,5" 
                    Padding="5" 
                    Click="btnSubmit_Click"
                    Width="300"
                    />

            <TextBlock x:Name="txtBlockVysledek" 
                       Text="Výsledek se zobrazí zde" 
                       TextAlignment="Center"
                       Margin="0,10" 
                       HorizontalAlignment="Center" 
                       FontWeight="SemiBold"
                       Width="500"
                       />
        </StackPanel>
    </Grid>
</Window>